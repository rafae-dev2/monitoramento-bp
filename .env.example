# Copie para o Netlify (Site configuration → Environment variables). NÃO faça commit deste arquivo.

# --- obrigatórios -------------------------------------------------------------
SOLINF_USER=SEU-USUARIO-DO-PORTAL
SOLINF_PASS=troque-esta-senha-aqui
CLIENT_OWNER=branco_peres_cana
CLIENT_NAME=branco-peres-cana

# --- já vêm com o valor correto deste tenant (só mexa se a Solinftec mudar) ---
AUTH_API=https://auth-api.saas-solinftec.com/auth-api-03/v2
SGPA_API=https://sgpa-api-br.saas-solinftec.com/slf03
SERVICE_API=https://api-br.saas-solinftec.com/mapv4/service-7
TILE_API=https://api-br.saas-solinftec.com/mapv4/tile-service-7
INTERP_API=https://api-br.saas-solinftec.com/mapv4/interpolation-service-7
MAP_URL=https://solinftec-frontends.saas-solinftec.com/solinftec-pwa-mapv4-prod/index.html
PORTAL_URL=https://branco-peres-cana.saas-solinftec.com
CD_CLIENT=204

# --- opcionais ----------------------------------------------------------------
# TTL do cache da sessão na função (segundos). O token do portal dura 7 dias.
PROPS_TTL_SECONDS=432000

# ---------------------------------------------------------------------------
# HISTORICO DE ALERTAS NO SUPABASE (opcional)
# ---------------------------------------------------------------------------
# Rode supabase/schema.sql e depois supabase/escrita-append-only.sql no SQL
# Editor do Supabase. Com a segunda, a chave anon basta: a funcao so insere em
# pwa_alertas (alertas disparados) e pwa_acessos (auditoria de login).
# Sem estas duas variaveis, o alerta na tela e a voz seguem funcionando; so
# deixa de existir o registro no banco.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=chave-anon-do-projeto

# Exigir uma chave no chamado da função (defesa contra uso por terceiros da sua URL).
# O valor fica visível no front-end; serve como barreira mínima, não como segredo.
APP_KEY=

# ---------------------------------------------------------------------------
# MODO LOCAL (sem variável no Netlify)
# ---------------------------------------------------------------------------
# Se SOLINF_USER / SOLINF_PASS não existirem aqui no Netlify, o app abre a tela
# "Entrar no monitoramento" e faz o login direto do navegador (a API de auth do
# portal aceita chamada cross-origin). Nesse modo a credencial fica guardada no
# próprio aparelho (localStorage), e NUNCA passa pela Netlify.
# Para apagar: menu ⚙ -> "Esquecer este aparelho".
# Para uso em vários aparelhos, prefira cadastrar SOLINF_USER/SOLINF_PASS aqui.
